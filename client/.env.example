# Copy to .env.local and fill in real values. Never commit .env.local.

# Email (SMTP). For Gmail use smtp.gmail.com and a Google App Password,
# not the account password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
FROM_EMAIL="IPO Matchmaker <your-account@example.com>"

# Set to true to skip sending email during local development
EMAIL_DISABLED=false

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001
